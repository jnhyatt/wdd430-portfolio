@@ -0,0 +1,18 @@
+import ProjectList from "./ProjectList";
+import { fetchFilteredProjects } from "@/lib/projects-db";
+
+export interface FilteredProjectsViewProps {
+  query: string;
+  currentPage: number;
+}
+
+export default async function FilteredProjectsView({
+  query,
+  currentPage,
+}: FilteredProjectsViewProps) {
+  const projects = await fetchFilteredProjects(query, currentPage);
+  if (projects.length === 0) {
+    return <p className="text-gray-400">No projects found.</p>;
+  }
+  return <ProjectList projects={projects} />;
+}
